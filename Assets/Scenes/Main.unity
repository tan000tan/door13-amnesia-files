  m_Script: {fileID: 11500000, guid: b09b44f9caf153446a49f2b2dff91711, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  prompt: "\u4EA4\u4E92"
  disabledPrompt: "\u65E0\u6CD5\u4F7F\u7528"
  requiredItemId: 
  lockedMessage: "\u5B83\u9501\u7740\u3002\u9700\u8981\u522B\u7684\u4E1C\u897F\u3002"
  minLoop: 0
  screenTitle: "\u7EC8\u7AEF \u2014 \u56DE\u5ECA7\u53F7\u5185\u7F51"
  files:
  - Title: "\u901A\u77E5 \xB7 \u56DE\u5ECA7\u53F7"
    Body: "\u56DE\u5ECA7\u53F7 \xB7 \u8BB0\u5FC6\u79D1\u5B66\u90E8\n\n\u672C\u6240\u4ECE\u4E8B\u957F\u65F6\u7A0B\u8BB0\u5FC6\u7F16\u7801\u7814\u7A76\u3002\n\u6240\u6709\u4EBA\u5458\u51ED\u6743\u9650\u901A\u884C\uFF0C\u53D7\u8BD5\u8005\u533A\u57DF\u975E\u6388\u6743\u8BF7\u52FF\u8FDB\u5165\u3002\n\n\u2014\u2014\u6240\u52A1\u5904"
    EvidenceFlag: 
    MinLoop: 0
  - Title: "\u5E94\u6025\u534F\u8BAE \xB7 \u53D7\u8BD5\u8005\u67E5\u8BE2"
    Body: "\u5E94\u6025\u534F\u8BAE\uFF1A\u53D7\u8BD5\u8005\u81EA\u52A9\u67E5\u8BE2\n\n\u6863\u6848\u7F16\u53F7\uFF1AT-13\n\u72B6\u6001\uFF1A\u7B2C
      12 \u6B21\u5FAA\u73AF\u7EC8\u6B62\n\u7EC8\u6B62\u539F\u56E0\uFF1A\u53D7\u8BD5\u8005\u62D2\u7EDD\u5F00\u95E8\n\n\u6CE8\uFF1A\u7B54\u6848\u5728\u4ED6\u7684\u8BB0\u5FC6\u91CC\u3002\n\u5176\u4F59\u6863\u6848\u5DF2\u52A0\u5BC6\uFF08\u6743\u9650\uFF1A13\u53F7\u95E8\uFF09\u3002"
    EvidenceFlag: ev_terminal_r0
    MinLoop: 0
  - Title: "\u5B9E\u9A8C\u65E5\u5FD7 \xB7 \u7B2C9~12\u6B21"
    Body: "\u5B9E\u9A8C\u65E5\u5FD7\uFF08\u8282\u9009\uFF09\n\n\u7B2C9\u6B21\u5FAA\u73AF\uFF1A\u53D7\u8BD5\u8005\u518D\u6B21\u62D2\u7EDD\u914D\u5408\u3002\n\u7B2C10\u6B21\uFF1A\u6539\u7528\u8BF1\u5BFC\uFF0C\u5931\u8D25\u3002\n\u7B2C11\u6B21\uFF1A\u8BF1\u5BFC\u5931\u8D25\u3002\u4ED6\u54ED\u4E86\uFF0C\u4F46\u8BB0\u6027\u5B8C\u597D\u3002\n\u7B2C12\u6B21\uFF1A\u89C1\u5F02\u5E38\u62A5\u544A\u3002\n\n\u2014\u2014\u8BB0\u5F55\u5458\uFF1A\u5468\u660E"
    EvidenceFlag: 
    MinLoop: 2
  - Title: "\u5F02\u5E38\u62A5\u544A \xB7 13\u53F7\u6837\u672C"
    Body: "\u5F02\u5E38\u62A5\u544A \xB7 13\u53F7\u6837\u672C\n\n\u73B0\u8C61\uFF1AT-13
      \u5728\u5FAA\u73AF\u91CD\u7F6E\u540E\u4FDD\u7559\u4E86\u5168\u90E8\u8BB0\u5FC6\u3002\n\u8FD9\u662F\u5341\u4E8C\u4E2A\u5B69\u5B50\u91CC\u552F\u4E00\u7684\u4E00\u4F8B\u3002\n\n\u63A8\u8BBA\uFF1A\u300E\u8BB0\u5FC6\u7A7F\u900F\u300F\u6210\u7ACB\u3002\n\u98CE\u9669\uFF1A\u53D7\u8BD5\u8005\u5DF2\u5F00\u59CB\u8D28\u7591\u5899\u4E0A\u7684\u8BA1\u6570\u3002\n\n\u5EFA\u8BAE\uFF1A\u8BA9\u4ED6\u81EA\u5DF1\u8D70\u5230\u7B2C\u5341\u4E09\u6247\u95E8\u3002\n\u2014\u2014\u4E3B\u4EFB\u529E\u516C\u5BA4"
    EvidenceFlag: ev_anomaly
    MinLoop: 3
  - Title: "\u6863\u6848 T-13 \xB7 \u5B8C\u6574\u7248"
    Body: "\u6863\u6848 T-13\uFF08\u5B8C\u6574\u7248\uFF09\n\n\u59D3\u540D\uFF1A\u6797\u6F88\n\u5165\u7EC4\uFF1A1998\u5E74\uFF08\u7F16\u53F7409\uFF09\n\u9879\u76EE\uFF1A\u8BB0\u5FC6\u7A7F\u900F
      \xB7 \u7B2C\u5341\u4E09\u6247\u95E8\u8BA1\u5212\n\u5FAA\u73AF\u6B21\u6570\uFF1A12\n\n\u7ED3\u8BBA\uFF1A\u5B9E\u9A8C\u6210\u529F\u3002\n\u53D7\u8BD5\u8005\u53EF\u4EE5\u505C\u4E0B\u4EFB\u610F\u4E00\u6B21\u5FAA\u73AF\u2014\u2014\n\u5982\u679C\u4ED6\u9009\u62E9\u8D70\u8FDB\u95E8\u540E\uFF0C\u5B9E\u9A8C\u5373\u544A\u7ED3\u675F\u3002"
    EvidenceFlag: ev_terminal_full
    MinLoop: 4
