  disabledPrompt: "\u65E0\u6CD5\u4F7F\u7528"
  requiredItemId: 
  lockedMessage: "\u5B83\u9501\u7740\u3002\u9700\u8981\u522B\u7684\u4E1C\u897F\u3002"
  minLoop: 0
  title: "\u6B7B\u4EA1\u8BB0\u5F55"
  body: "\u6B7B\u4EA1\u8BB0\u5F55\uFF08\u6D82\u6539\u75D5\u8FF9\u4E25\u91CD\uFF09\uFF1A\n\n\u7F16\u53F7
    T-13\n\u59D3\u540D\uFF1A\u6797\u6F88\n2004\u5E7411\u67082\u65E5\uFF0C\u4E8E\u56DE\u5ECA7\u53F7\u5730\u4E0B\u533A\u57DF\n\u6B7B\u56E0\uFF1A\u5FAA\u73AF\u88C5\u7F6E\u4F5C\u4E1A\u4E8B\u6545\n\n\u2014\u2014\u300E\u4E8B\u6545\u300F\u4E00\u8BCD\u88AB\u53CD\u590D\u63CF\u7C97\uFF0C\u50CF\u662F\u5728\u63A9\u76D6\u4EC0\u4E48\u3002\n\n\u80CC\u9762\u6709\u4E00\u884C\u540E\u6765\u5199\u4E0A\u7684\u5B57\uFF1A\n\n\u300E\u4ED6\u6B7B\u4E86\u3002\u4F46\u88C5\u7F6E\u628A\u4ED6\u5E26\u56DE\u6765\u4E86\u3002\n
    \u6216\u8005\u8BF4\uFF0C\u88C5\u7F6E\u4ECE\u6765\u5C31\u6CA1\u6709\u8BA9\u4ED6\u771F\u6B63\u6B7B\u53BB\u3002\n
    \u4ED6\u53EA\u662F\u2026\u2026\u6BCF\u6B21\u90FD\u5728\u540C\u4E00\u4E2A\u5730\u65B9\u9192\u6765\u3002\n
    \u2014\u2014Dr. \u79E6\u300F"
  evidenceFlag: ev_death
